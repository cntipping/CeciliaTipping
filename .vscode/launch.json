{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flask API (port 5001)",
      "type": "debugpy",
      "request": "launch",
      "module": "flask",
      "cwd": "${workspaceFolder}",
      "args": [
        "--app",
        "backend.app",
        "run",
        "--port",
        "5001",
        "--no-debugger",
        "--no-reload"
      ],
      "jinja": true,
      "justMyCode": true
    },
    {
      "name": "React (start npm run dev first)",
      "type": "chrome",
      "request": "launch",
      "url": "http://127.0.0.1:5173",
      "webRoot": "${workspaceFolder}/frontend/src"
    }
  ]
}
